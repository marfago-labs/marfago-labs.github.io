{
  "name": "marfago-labs-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "sync-blog": "node scripts/sync-blog.mjs",
    "backfill-freshness": "node scripts/backfill-content-freshness.mjs",
    "dev": "npm run sync-blog && astro dev",
    "dev:lan": "npm run sync-blog && astro dev --host",
    "build": "npm run sync-blog && astro build",
    "preview": "astro preview",
    "preview:lan": "astro preview --host",
    "check": "astro check",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.10",
    "astro": "^7.4.13",
    "mermaid": "^12.3.0",
    "typescript": "^5.8.3",
    "unist-util-visit": "^5.1.0"
  }
}
