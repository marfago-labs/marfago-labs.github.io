---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { postSlug } from "../lib/blog";

const LATEST = 5;

const posts = (await getCollection("blog"))
  .filter((post) => post.data.order !== 0)
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime() ||
      a.data.title.localeCompare(b.data.title),
  )
  .slice(0, LATEST);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

<BaseLayout
  title="Marco Fago"
  description="Software engineer in Dublin. Agentic systems, and how to know an AI answer is right."
>
  <div class="page-content">
    <h1>Hi, I'm Marco</h1>
    <p class="lead">
      I'm a software engineer in Dublin. I've been building distributed systems and ML
      platforms for more than 25 years, and these days most of my time goes into agentic
      systems.
    </p>
    <p>
      Most of what I write about comes from one question: when an AI system gives me an
      answer, how do I know it's right? The series
      <a href="/blog/series-index/">Building an Evaluation Lab by Accident</a> tells how I
      got there.
    </p>
  </div>

  <section class="section page-content">
    <h2>Projects</h2>
    <div class="project">
      <img
        class="project-logo"
        src="/projects/paper-research-logo.svg"
        alt="The paper-research logo: a bee with a magnifying glass for a head, over a stack of books."
        width="112"
        height="97"
      />
      <p>
        <strong><a href="https://github.com/marfago-labs/paper-research">paper-research</a></strong>
        is a Claude Code plugin for finding, reading, and discussing research papers. It keeps
        notes and a knowledge graph in plain files, and every claim in the graph records where
        it came from and how it was checked.
      </p>
    </div>
    <p>
      <strong>An NER evaluation pipeline</strong>, in three parts:
    </p>
    <ul>
      <li>
        <a href="https://github.com/marfago-labs/ner-gold-generator">ner-gold-generator</a>
        builds labelled datasets. Models propose the entities, and the code computes every
        offset from the source text, so no position is taken on trust.
      </li>
      <li>
        <a href="https://github.com/marfago-labs/ner-dataset">ner-dataset</a> holds the
        datasets, with <a href="/ner-dataset/">quality statistics</a>.
      </li>
      <li>
        <a href="https://github.com/marfago-labs/ner-detector">ner-detector</a> compares
        regex, BERT, GLiNER, NuNER, and LLM extractors on that data, and publishes the
        <a href="/ner-detector/">results</a>.
      </li>
    </ul>
    <p class="muted">
      <a href="/projects/">All projects</a>
    </p>
  </section>

  <section class="section page-content">
    <h2>Writing</h2>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString().slice(0, 10)}>
              {formatDate(post.data.date)}
            </time>
            <a href={`/blog/${postSlug(post.id)}/`}>{post.data.title}</a>
          </li>
        ))
      }
    </ul>
    <p class="muted">
      <a href="/blog/">All posts</a>
    </p>
  </section>

  <section class="section page-content">
    <h2>Elsewhere</h2>
    <p>
      I write about what I learn here and on
      <a href="https://www.linkedin.com/in/marco-fago/">LinkedIn</a>. I was also a technical
      reviewer of
      <a href="https://www.amazon.com/Agentic-Design-Patterns-Hands-Intelligent/dp/3032014018"
        ><em>Agentic Design Patterns</em></a
      >
      by Antonio Gulli.
    </p>
  </section>
</BaseLayout>

<style>
  .section {
    margin-top: 2.5rem;
  }
  .section > h2 {
    margin-bottom: 0.75rem;
  }
  .project {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .project p {
    margin: 0;
  }
  .project-logo {
    flex: 0 0 7rem;
    width: 7rem;
    height: auto;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 0.6rem;
  }
  .post-list li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }
  .post-list time {
    flex: 0 0 6.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 480px) {
    .project {
      flex-direction: column;
      align-items: flex-start;
    }
    .post-list li {
      flex-direction: column;
      gap: 0.1rem;
    }
  }
</style>
