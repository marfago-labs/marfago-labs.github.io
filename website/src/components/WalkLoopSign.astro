---
import { readFileSync } from "node:fs";
import path from "node:path";

// The build runs from website/, and the bundled page no longer sits next to src/, so resolve from there.
const svgPath = path.join(process.cwd(), "public/blog/diagrams/walk-loop-sign.svg");
const markup = readFileSync(svgPath, "utf-8");

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["walk-loop-sign", className]} set:html={markup} />

<style>
  .walk-loop-sign :global(svg) {
    display: block;
    width: 100%;
    max-width: 14rem;
    height: auto;
  }
</style>
