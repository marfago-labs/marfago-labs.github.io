---
import markup from "../../public/blog/diagrams/walk-loop-sign.svg?raw";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["walk-loop-sign", className]} set:html={markup} />

<style>
  .walk-loop-sign :global(svg) {
    display: block;
    width: 100%;
    max-width: 14rem;
    height: auto;
  }
</style>
